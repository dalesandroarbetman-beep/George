{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "geo-scan/1.0",
  "title": "GEO 公开站点扫描产物",
  "type": "object",
  "required": ["contract_version", "site", "scanned_at", "mode", "robots", "sitemap", "pages", "observations"],
  "$defs": {
    "observation": {
      "type": "object",
      "required": ["summary", "url", "observed_at", "evidence_summary"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "observed_at": {"type": "string", "format": "date-time"},
        "evidence_summary": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "contract_version": {"const": "geo-scan/1.0"},
    "site": {"type": "string", "format": "uri"},
    "scanned_at": {"type": "string", "format": "date-time"},
    "mode": {"const": "read_only_rendered_browser"},
    "robots": {"type": "object"},
    "sitemap": {"type": "object"},
    "pages": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "observations": {
      "type": "object",
      "required": ["positive", "risks"],
      "properties": {
        "positive": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
        "risks": {"type": "array", "items": {"$ref": "#/$defs/observation"}}
      },
      "additionalProperties": false
    },
    "limits": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
